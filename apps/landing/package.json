    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@pulse/tsconfig": "workspace:*",
    "@sveltejs/adapter-vercel": "^7.0.3",
    "@sveltejs/kit": "3.2.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vite": "8.3.8",
    "vitest": "^5.1.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
