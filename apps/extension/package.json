{
  "name": "@pulse/extension",
  "version": "0.2.3",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "NODE_OPTIONS=--disable-warning=DEP0205 vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm --filter @pulse/ui build && playwright test",
    "test:mv3": "pnpm --filter @pulse/ui build && pnpm build && pnpm verify-manifest dist/manifest.json --post-build && playwright test --config=playwright.mv3.config.ts",
    "test:e2e:extension": "pnpm test:mv3",
    "test:e2e:full": "pnpm --filter @pulse/ui build && env -u CI playwright test",
    "test:regression": "vitest run tests/unit/regression/parser-regression.test.ts",
    "health-check": "MISSIONPULSE_CONNECTOR_HEALTH_FIXTURE_ONLY=1 node --import tsx tests/health/run-health-checks.ts",
    "health-check:json": "MISSIONPULSE_CONNECTOR_HEALTH_FIXTURE_ONLY=1 node --import tsx tests/health/run-health-checks.ts --json",
    "lint": "eslint . --ext .ts,.svelte",
    "lint:fix": "eslint . --ext .ts,.svelte --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "verify-manifest": "tsx scripts/verify-manifest.ts",
    "validate:mv3-runtime": "pnpm build && node scripts/validate-mv3-runtime.mjs",
    "bump-version": "tsx scripts/bump-version.ts",
    "build:extension": "bash scripts/build-extension.sh",
    "release:seal-candidate": "tsx scripts/seal-tested-dist.ts",
    "package:sealed": "tsx scripts/package-sealed-dist.ts",
    "verify:release-artifact": "tsx scripts/verify-release-artifact.ts"
  },
  "dependencies": {
    "@pulse/domain": "workspace:*",
    "@pulse/ui": "workspace:*",
    "@supabase/supabase-js": "^2.112.3",
    "svelte": "^5.56.9",
    "xstate": "^5.32.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.61.1",
    "@pulse/tsconfig": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.6",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.1",
    "eslint-plugin-svelte": "^3.23.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "8.2.2",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  }
}
